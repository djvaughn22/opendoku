{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "snowdoku.com"
        }
      ],
      "destination": "/slopedoku/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://www.idontcry.com https://idontcry.com http://localhost:*"
        }
      ]
    }
  ]
}
